# Copia este fichero a .env y rellena lo que necesites. Nunca subas .env al repo
# (ya está en .gitignore). Todas las variables son opcionales en desarrollo,
# con el fallback que se documenta en el propio código.

# Pipeline de imágenes (Fase V) — scripts/images/generate.ts
GEMINI_API_KEY=

# Sesión de cuenta B2B (lib/auth/session.ts)
SESSION_SECRET=

# Analítica — Consent Mode v2 / GTM (components/analitica/gtag-script.tsx)
NEXT_PUBLIC_GTM_ID=

# Redsys — pago con tarjeta (lib/pago/redsys.ts). Sin configurar, usa las
# credenciales de entorno de pruebas PÚBLICAS de Redsys (no válidas para
# producción real).
REDSYS_MERCHANT_CODE=
REDSYS_TERMINAL=
REDSYS_SECRET_KEY=
REDSYS_ENVIRONMENT=test

# Sincronización nocturna con el ERP (scripts/sync-erp-nocturno.ts) — una de las dos:
ERP_SYNC_SOURCE_URL=
ERP_SYNC_SOURCE_PATH=

# Sincronización de catálogo desde Shopify (scripts/sync-shopify.ts).
# Ver SHOPIFY-SYNC.md para cómo crear la app personalizada y el token.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_API_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-01
